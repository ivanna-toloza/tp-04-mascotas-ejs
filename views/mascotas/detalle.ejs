<article class="detalle">
    <img src="<%= mascota.imagen %>" alt="Fotografía o ilustración de <%= mascota.nombre %>" width="120" height="120">
    <p class="etiqueta">
        <%= mascota.especie %> | <%= mascota.estado %>
    </p>
    <h1>
        <%= mascota.nombre %>
    </h1>
    <p><strong>Edad:</strong>
        <%= mascota.edad %> años
    </p>
    <p><strong>Descripción:</strong>
        <%= mascota.descripcion %>
    </p>
    <a class="boton" href="/mascotas">Volver al catálogo</a>
</article>